# ─────────────────────────────────────────────────────────────────────────────
# API base URL — único punto a tocar para cambiar de entorno.
# Frontend lo lee desde `src/lib/api-config.ts` (VITE_API_URL).
# ─────────────────────────────────────────────────────────────────────────────

# Desarrollo local (Vite + uvicorn en sus propios procesos)
VITE_API_URL=http://localhost:8000

# Contenedor docker compose (red interna del proyecto)
# VITE_API_URL=http://backend:8000

# Staging
# VITE_API_URL=https://api.staging.panamacompliance.com

# Producción
# VITE_API_URL=https://api.panamacompliance.com
